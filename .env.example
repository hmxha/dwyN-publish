# Immutable image produced by GitLab CI.
APP_IMAGE=ghcr.io/hmxha/dwy/vietnam:replace-with-build-tag
GHCR_USERNAME=hmxha

# Test-server address used to replace the historical public IP in seed data.
PUBLIC_HOST=127.0.0.1

# The legacy seed contains a large historical dataset. Set to 1 only after it
# has been reviewed and approved for the isolated test server.
ALLOW_LEGACY_SEED=0

# Use test-only credentials. Keep .env out of Git.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

# Test deployments disable external payment/notification integrations by
# default. Set test credentials here only when an integration must be checked.
PAYMENT_SECRET=test-disabled
PAYMENT_FLYER_KEY=test-disabled
PAYMENT_MID=test-disabled
XWORLD_SECRET_KEY=test-disabled
XWORLD_MCH_ID=test-disabled
DINGDING_DING_TOKEN=test-disabled
SHUSHU_APP_ID=test-disabled

# Keep all application processes conservative on a 4-core/8-GB test server.
APP_GOMAXPROCS=1
TZ=Asia/Shanghai
